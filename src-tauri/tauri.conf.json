{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniTC",
  "version": "0.1.0",
  "identifier": "com.minitc.minitc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mini TC",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#15151c",
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:"
        ],
        "media-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost"
        ],
        "frame-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:"
        ],
        "worker-src": ["'self'", "blob:"],
        "font-src": ["'self'", "data:"],
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'unsafe-eval'", "'unsafe-inline'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:",
          "http://localhost:5173"
        ],
        "media-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "http://localhost:5173"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "ws://localhost:5173",
          "http://localhost:5173"
        ],
        "frame-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "http://localhost:5173"
        ],
        "worker-src": ["'self'", "blob:"],
        "font-src": ["'self'", "data:"],
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NkIwQTcxN0ExQ0UwN0IKUldSNzRCeDZjUXByUkY1MURpVW1rT1VDTGJBUmlXSjRyNHRxT3MxaWk4ZU9PNjYvRVBKY0JnWXcK",
      "endpoints": [
        "https://minitc-1251477527.cos.ap-guangzhou.myqcloud.com/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
