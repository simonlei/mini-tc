{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniTC",
  "version": "0.1.0",
  "identifier": "com.minitc.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mini TC",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMTE2M0ZDRTYzMzMwRjgKUldUNE1EUG0vR01SWGpWNG1BVXpXTmtJdW1sZFhOaXI0QmYwRDVaeU84Wm9VbE5NUDdFSXp5UkgK",
      "endpoints": [
        "https://cnb.cool/simon-lei/mini-tc/-/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
