{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniTC",
  "version": "0.1.0",
  "identifier": "com.minitc.minitc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mini TC",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#15151c"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NkIwQTcxN0ExQ0UwN0IKUldSNzRCeDZjUXByUkY1MURpVW1rT1VDTGJBUmlXSjRyNHRxT3MxaWk4ZU9PNjYvRVBKY0JnWXcK",
      "endpoints": [
        "https://github.com/simonlei/mini-tc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
