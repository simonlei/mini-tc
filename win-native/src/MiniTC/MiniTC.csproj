<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MiniTC</RootNamespace>
    <AssemblyName>MiniTC</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\minitc.ico</ApplicationIcon>

    <!-- Stays on the plain net8.0-windows TFM on purpose: we reach Windows
         through P/Invoke only, so pulling in the WinRT projections (and their
         restore cost) would buy nothing. Win10 1809 is the effective floor,
         enforced at runtime by WindowTheming's build checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>MiniTC</Product>
    <Company>MiniTC</Company>
    <Description>A lightweight native Windows dual-pane file manager</Description>

    <!-- Startup latency: R2R removes most JIT work on the hot path. -->
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>

    <!-- PdfiumViewer and its *.Native.* packages target net20, so NuGet emits
         NU1701 ("restored using .NETFramework instead of net8.0-windows"). The
         packages are known to work here via the System.Drawing.Common shim, and
         the warning fires on every build — silence it to keep output readable. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <!-- PDF inline preview (B1): PdfiumViewer renders pages natively (no WebView2).
         It targets net20 and relies on System.Drawing, so the net8-compatible
         System.Drawing.Common shim must be referenced explicitly.
         PdfiumViewer ships ONLY the managed wrapper; the native pdfium.dll comes
         from the *.Native.* packages below. Omitting them throws
         "Unable to load DLL 'pdfium.dll'" at runtime. Both x86 and x86_64 are
         referenced so the DLL is found whether the WPF AnyCPU process runs 32-bit
         (Prefer32Bit default) or 64-bit. -->
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="PdfiumViewer.Native.x86.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\minitc.ico" Condition="Exists('Assets\minitc.ico')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The behaviour worth testing (sort order, combo parsing, path expansion)
         lives in internal helpers; expose them to the test project only. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MiniTC.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
