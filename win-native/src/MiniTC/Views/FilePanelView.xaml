<UserControl x:Class="MiniTC.Views.FilePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MiniTC.Views"
             xmlns:models="clr-namespace:MiniTC.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AllowDrop="True">

  <UserControl.Resources>
    <views:FileIconConverter x:Key="FileIcon" />
    <views:StringToVisibilityConverter x:Key="StringToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
  </UserControl.Resources>

  <Border x:Name="PanelBorder"
          Background="{DynamicResource Brush.Layer.Background}"
          BorderBrush="{DynamicResource Brush.Stroke.Default}"
          BorderThickness="1" CornerRadius="{DynamicResource Radius.Layer}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ Tab strip ============ -->
      <Grid Grid.Row="0" Margin="4,4,4,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="TabList" Grid.Column="0"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding ActiveTab, Mode=OneWay}"
                 SelectionChanged="OnTabSelectionChanged"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,2,0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="8,3">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background"
                                Value="{DynamicResource Brush.Subtle.Hover}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Root" Property="Background"
                                Value="{DynamicResource Brush.Selection}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                <TextBlock Text="{Binding Title}" MaxWidth="150" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Content="&#xE711;" Style="{StaticResource Button.Icon}"
                        Width="16" Height="16" FontSize="8" Margin="6,0,-4,0"
                        Click="OnCloseTabClick" Tag="{Binding}"
                        ToolTip="关闭标签页" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Column="1" Content="&#xE710;" Style="{StaticResource Button.Icon}"
                Click="OnAddTabClick" ToolTip="新建标签页" />
      </Grid>

      <!-- ============ Address bar ============ -->
      <Grid Grid.Row="1" Margin="4,4,4,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Drive picker. Uses Button.Subtle because Button.Icon's template
             renders Content as text; the two glyphs here carry their own
             FontFamily, so they render correctly on their own. -->
        <Button Grid.Column="0" Style="{StaticResource Button.Subtle}" Width="34"
                Height="24" Padding="0"
                Click="OnDrivePickerClick" ToolTip="选择驱动器">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEDA2;" FontFamily="{DynamicResource Font.Icons}" FontSize="14"
                       VerticalAlignment="Center" />
            <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Font.Icons}" FontSize="8"
                       VerticalAlignment="Center" Margin="2,2,0,0" />
          </StackPanel>
        </Button>

        <!-- Breadcrumbs (default) -->
        <Border x:Name="CrumbHost" Grid.Column="1" Margin="2,0"
                Background="{DynamicResource Brush.Layer.Alt}"
                BorderBrush="{DynamicResource Brush.Stroke.Default}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Control}"
                MouseLeftButtonDown="OnCrumbHostClick">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="2,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Text}" Tag="{Binding Path}"
                            Click="OnCrumbClick" Padding="5,2"
                            Style="{StaticResource Button.Subtle}"
                            MaxWidth="220" />
                    <TextBlock Text="&#xE76C;" FontFamily="{DynamicResource Font.Icons}"
                               FontSize="8" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- Editable path -->
        <TextBox x:Name="PathEditor" Grid.Column="1" Margin="2,0"
                 Visibility="Collapsed"
                 KeyDown="OnPathEditorKeyDown" LostFocus="OnPathEditorLostFocus" />

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="&#xE70F;" Style="{StaticResource Button.Icon}"
                  Click="OnEditPathClick" ToolTip="编辑路径" />
          <Button Content="&#xE8C8;" Style="{StaticResource Button.Icon}"
                  Click="OnCopyPathClick" ToolTip="复制当前路径" />
          <Button Content="&#xE72C;" Style="{StaticResource Button.Icon}"
                  Click="OnRefreshClick" ToolTip="刷新 (F5)" />
        </StackPanel>
      </Grid>

      <!-- ============ Filter bar ============ -->
      <Border Grid.Row="2" Margin="4,0,4,2" Padding="8,3"
              Background="{DynamicResource Brush.Accent.Muted}"
              CornerRadius="{DynamicResource Radius.Control}"
              Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource Font.Icons}"
                     FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center"
                     Text="{Binding FilterQuery}" FontWeight="SemiBold" />
          <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource Button.Icon}"
                  Width="18" Height="18" FontSize="8" Click="OnClearFilterClick"
                  ToolTip="清除过滤 (Esc)" />
        </Grid>
      </Border>

      <!-- ============ File list ============ -->
      <Grid Grid.Row="3">
        <ListView x:Name="FileList" Style="{StaticResource ListView.Files}"
                  ItemsSource="{Binding Entries}"
                  IsTextSearchEnabled="False"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnItemDoubleClick"
                  PreviewKeyDown="OnListPreviewKeyDown"
                  TextInput="OnListTextInput"
                  PreviewMouseLeftButtonDown="OnListMouseDown"
                  PreviewMouseMove="OnListMouseMove"
                  MouseRightButtonUp="OnListRightButtonUp"
                  GotKeyboardFocus="OnListGotFocus"
                  AllowDrop="True"
                  DragOver="OnListDragOver"
                  DragLeave="OnListDragLeave"
                  Drop="OnListDrop">
          <ListView.View>
            <GridView AllowsColumnReorder="False"
                      ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeader.Fluent}">
              <GridViewColumn x:Name="NameColumn" Width="320">
                <GridViewColumnHeader Content="名称" Tag="Name" Click="OnColumnHeaderClick" />
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type models:FileEntry}">
                    <Grid>
                      <StackPanel Orientation="Horizontal"
                                  Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}">
                        <Image Width="16" Height="16" Margin="0,0,6,0"
                               Source="{Binding ., Converter={StaticResource FileIcon}}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </StackPanel>

                      <!-- Inline rename, like Explorer's F2 -->
                      <TextBox Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                               Loaded="OnRenameEditorLoaded"
                               KeyDown="OnRenameEditorKeyDown"
                               LostFocus="OnRenameEditorLostFocus"
                               Tag="{Binding}" Padding="2,0" Margin="0,-1" />
                    </Grid>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>

              <GridViewColumn Width="90">
                <GridViewColumnHeader Content="大小" Tag="Size" Click="OnColumnHeaderClick" />
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type models:FileEntry}">
                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>

              <GridViewColumn Width="80">
                <GridViewColumnHeader Content="类型" Tag="Type" Click="OnColumnHeaderClick" />
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type models:FileEntry}">
                    <TextBlock Text="{Binding TypeText}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>

              <GridViewColumn Width="130">
                <GridViewColumnHeader Content="修改时间" Tag="Modified" Click="OnColumnHeaderClick" />
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type models:FileEntry}">
                    <TextBlock Text="{Binding ModifiedText}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>

        <!-- Error / empty overlays -->
        <Border Background="{DynamicResource Brush.Layer.Background}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="&#xE783;" FontFamily="{DynamicResource Font.Icons}" FontSize="32"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.Danger}" />
            <TextBlock Text="{Binding ErrorMessage}" Margin="0,12,0,0" MaxWidth="320"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ Status bar ============ -->
      <Border Grid.Row="4" Padding="8,4" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource Brush.Stroke.Default}">
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Secondary}"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
  </Border>
</UserControl>
