<Window x:Class="MiniTC.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置" Height="620" Width="720" MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.App.Background}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Font.Size.Body}">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="点击某个命令的组合键按钮开始录制，按下新的组合键即可绑定；Esc 取消录制。"
               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox" Grid.Column="0" Padding="8,5"
               TextChanged="OnSearchChanged" />

      <Button Grid.Column="1" Content="全部恢复默认" Margin="8,0,0,0" Padding="12,5"
              Click="OnResetAllClick"
              BorderBrush="{DynamicResource Brush.Stroke.Strong}" />
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="ScopeList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,14">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Secondary}"
                         Margin="0,0,0,6" />

              <Border Background="{DynamicResource Brush.Layer.Background}"
                      BorderBrush="{DynamicResource Brush.Stroke.Default}" BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.Layer}" Padding="4">
                <ItemsControl ItemsSource="{Binding Commands}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="6,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Text="{Binding Description}"
                                     Style="{StaticResource Text.Secondary}"
                                     Visibility="{Binding DescriptionVisibility}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <ItemsControl ItemsSource="{Binding Bindings}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Display}" Tag="{Binding}"
                                        Click="OnRecordClick" Margin="0,0,4,0" MinWidth="92"
                                        Background="{Binding Background}"
                                        BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                                        ToolTip="{Binding ToolTip}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Button Content="&#xE710;" Style="{StaticResource Button.Icon}"
                                  Tag="{Binding}" Click="OnAddBindingClick"
                                  ToolTip="添加一个组合键" />
                          <Button Content="&#xE777;" Style="{StaticResource Button.Icon}"
                                  Tag="{Binding}" Click="OnResetCommandClick"
                                  ToolTip="恢复该命令的默认绑定" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,6" CornerRadius="4"
            Background="{DynamicResource Brush.Layer.Background}"
            Visibility="Collapsed" x:Name="StatusHost">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Style="{StaticResource Button.Accent}" MinWidth="92"
              Click="OnConfirmClick" />
      <Button Content="取消" MinWidth="92" Margin="8,0,0,0" Padding="16,5"
              Click="OnCancelClick" IsCancel="True"
              BorderBrush="{DynamicResource Brush.Stroke.Strong}" />
    </StackPanel>
  </Grid>
</Window>
