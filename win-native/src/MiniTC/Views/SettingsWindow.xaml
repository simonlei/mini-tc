<Window x:Class="MiniTC.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览设置" Height="480" Width="560" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.App.Background}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Font.Size.Body}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="文本预览后缀" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                 Text="勾选的后缀会以文本方式预览。图片与视频由系统解码器识别，无需在此配置。" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="NewExtBox" Grid.Column="0" Padding="8,5" KeyDown="OnNewExtKeyDown" />
      <Button Grid.Column="1" Content="添加" Margin="8,0,0,0" Padding="14,5" Click="OnAddClick"
              BorderBrush="{DynamicResource Brush.Stroke.Strong}" />
      <Button Grid.Column="2" Content="恢复默认" Margin="8,0,0,0" Padding="14,5" Click="OnResetClick"
              BorderBrush="{DynamicResource Brush.Stroke.Strong}" />
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource Brush.Layer.Background}"
            BorderBrush="{DynamicResource Brush.Stroke.Default}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Layer}" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ExtensionList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Content="{Binding Display}"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          Foreground="{DynamicResource Brush.Text.Primary}"
                          VerticalContentAlignment="Center" />

                <TextBlock Grid.Column="1" Text="内置" Style="{StaticResource Text.Secondary}"
                           Visibility="{Binding BuiltinVisibility}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="确定" Style="{StaticResource Button.Accent}" MinWidth="92" Click="OnConfirmClick" />
      <Button Content="取消" MinWidth="92" Margin="8,0,0,0" Padding="16,5"
              Click="OnCancelClick" IsCancel="True"
              BorderBrush="{DynamicResource Brush.Stroke.Strong}" />
    </StackPanel>
  </Grid>
</Window>
