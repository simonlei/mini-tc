<Application x:Class="MiniTC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 is swapped at runtime by ThemeService when the theme changes. -->
        <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
        <ResourceDictionary Source="Themes/Controls.Core.xaml" />
        <ResourceDictionary Source="Themes/Controls.List.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
