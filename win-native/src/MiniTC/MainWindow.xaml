<Window x:Class="MiniTC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MiniTC.Views"
        Title="MiniTC" Height="800" Width="1200" MinHeight="500" MinWidth="820"
        Background="{DynamicResource Brush.App.Background}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Font.Size.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <views:ToastKindToBrushConverter x:Key="ToastBrush" />
    <views:EnumEqualsConverter x:Key="EnumEquals" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============ Command bar ============ -->
    <Border x:Name="CommandBar" Grid.Row="0" Padding="6,4"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Stroke.Default}">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="文件" Click="OnFileMenuClick" />
          <Button Content="编辑" Click="OnEditMenuClick" />
          <Button Content="查看" Click="OnViewMenuClick" />
          <Button Content="配置" Click="OnConfigMenuClick" />
          <Button Content="帮助" Click="OnHelpMenuClick" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- Eye / horizontal swap arrows / send-to-target: these three read
               correctly at 14px. Document-shaped glyphs (E8FF, E8B7) were
               indistinguishable from an empty box at toolbar size. -->
          <Button Content="&#xE7B3;" Style="{StaticResource Button.Icon}"
                  Click="OnTogglePreviewClick" ToolTip="切换预览 (Ctrl+Q)" />
          <Button Content="&#xE8AB;" Style="{StaticResource Button.Icon}"
                  Click="OnSwapPanelsClick" ToolTip="交换左右面板路径" />
          <Button Content="&#xE8A0;" Style="{StaticResource Button.Icon}"
                  Click="OnEqualizePanelsClick" ToolTip="另一栏跳转到当前目录" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Dual panes ============ -->
    <Grid Grid.Row="1" Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="RightColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left slot: file pane or preview. The player is created on first use:
           constructing a MediaElement spins up Media Foundation, which costs
           several hundred milliseconds and ~150 MB we must not pay at startup. -->
      <Grid Grid.Column="0">
        <views:FilePanelView x:Name="LeftPanelView" />
        <views:PreviewView x:Name="LeftPreview" Visibility="Collapsed" />
        <Grid x:Name="LeftVideoHost" />
      </Grid>

      <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" ShowsPreview="False"
                    DragCompleted="OnSplitterDragCompleted" />

      <!-- Right slot: file pane or preview -->
      <Grid Grid.Column="2">
        <views:FilePanelView x:Name="RightPanelView" />
        <views:PreviewView x:Name="RightPreview" Visibility="Collapsed" />
        <Grid x:Name="RightVideoHost" />
      </Grid>
    </Grid>

    <!-- ============ Toast ============ -->
    <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,28" Padding="14,8" MaxWidth="620"
            Background="{DynamicResource Brush.Layer.Raised}"
            BorderBrush="{DynamicResource Brush.Stroke.Strong}" BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Direction="270" />
      </Border.Effect>
      <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap"
                 Foreground="{Binding ToastKind, Converter={StaticResource ToastBrush}}" />
    </Border>
  </Grid>
</Window>
