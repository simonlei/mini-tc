<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Windows 11 Fluent light tokens, flattened to opaque colours. -->

  <Color x:Key="Color.App.Background">#FFF3F3F3</Color>
  <Color x:Key="Color.Layer.Background">#FFFFFFFF</Color>
  <Color x:Key="Color.Layer.Alt">#FFFAFAFA</Color>
  <Color x:Key="Color.Layer.Raised">#FFFFFFFF</Color>

  <Color x:Key="Color.Stroke.Default">#FFE5E5E5</Color>
  <Color x:Key="Color.Stroke.Strong">#FFCFCFCF</Color>

  <Color x:Key="Color.Text.Primary">#FF1A1A1A</Color>
  <Color x:Key="Color.Text.Secondary">#FF5D5D5D</Color>
  <Color x:Key="Color.Text.Tertiary">#FF8A8A8A</Color>
  <Color x:Key="Color.Text.Disabled">#FFA5A5A5</Color>

  <Color x:Key="Color.Subtle.Hover">#0A000000</Color>
  <Color x:Key="Color.Subtle.Pressed">#06000000</Color>

  <Color x:Key="Color.Selection">#1F000000</Color>
  <Color x:Key="Color.Selection.Inactive">#12000000</Color>

  <Color x:Key="Color.Danger">#FFC42B1C</Color>
  <Color x:Key="Color.Success">#FF0F7B0F</Color>
  <Color x:Key="Color.Warning">#FF9D5D00</Color>

  <SolidColorBrush x:Key="Brush.App.Background" Color="{StaticResource Color.App.Background}" />
  <SolidColorBrush x:Key="Brush.Layer.Background" Color="{StaticResource Color.Layer.Background}" />
  <SolidColorBrush x:Key="Brush.Layer.Alt" Color="{StaticResource Color.Layer.Alt}" />
  <SolidColorBrush x:Key="Brush.Layer.Raised" Color="{StaticResource Color.Layer.Raised}" />

  <SolidColorBrush x:Key="Brush.Stroke.Default" Color="{StaticResource Color.Stroke.Default}" />
  <SolidColorBrush x:Key="Brush.Stroke.Strong" Color="{StaticResource Color.Stroke.Strong}" />

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />

  <SolidColorBrush x:Key="Brush.Subtle.Hover" Color="{StaticResource Color.Subtle.Hover}" />
  <SolidColorBrush x:Key="Brush.Subtle.Pressed" Color="{StaticResource Color.Subtle.Pressed}" />

  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
  <SolidColorBrush x:Key="Brush.Selection.Inactive" Color="{StaticResource Color.Selection.Inactive}" />

  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />

  <SolidColorBrush x:Key="Brush.Preview.Canvas" Color="#FFECECEC" />

</ResourceDictionary>
