<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Segoe UI Variable is the Windows 11 UI face; Segoe UI is the Windows 10
       fallback. Likewise Fluent Icons (Win11) falls back to MDL2 (Win10) - the
       glyph code points we use exist in both fonts. -->
  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.UiDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <sys:Double x:Key="Font.Size.Small">11.5</sys:Double>
  <sys:Double x:Key="Font.Size.Body">12.5</sys:Double>
  <sys:Double x:Key="Font.Size.Title">14</sys:Double>

  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Layer">6</CornerRadius>

  <!-- ==================== Focus ==================== -->

  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" StrokeThickness="1" RadiusX="3" RadiusY="3"
                     Stroke="{DynamicResource Brush.Text.Secondary}" StrokeDashArray="2 2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== Text ==================== -->

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ==================== ScrollBar ==================== -->

  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Root" Background="{DynamicResource Brush.Text.Tertiary}"
                  CornerRadius="3" Margin="3" Opacity="0.65" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.LineButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                              Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBar.Thumb}" MinHeight="24" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                              Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" MinWidth="24" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== Buttons ==================== -->

  <Style x:Key="Button.Subtle" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Radius.Control}"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Subtle.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Subtle.Pressed}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Button.Subtle}" />

  <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource Radius.Control}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Layer.Raised}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
    <!-- 14 is the smallest size at which MDL2 line work stays readable; at 12
         the thinner glyphs collapse into a blur. -->
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Radius.Control}"
                  SnapsToDevicePixels="True">
            <!-- The glyph is rendered by an explicit TextBlock rather than a
                 ContentPresenter on purpose. A presenter hosts a string in a
                 TextBlock it creates implicitly, and font values coming from a
                 Style setter never reach that TextBlock: property inheritance
                 skips setter values and lands on the Window's local FontFamily,
                 so every glyph came out as tofu. A local value set right here
                 does participate in inheritance. Buttons that need non-text
                 content use Button.Subtle instead. -->
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{DynamicResource Font.Icons}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Subtle.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Subtle.Pressed}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToggleButton.Tool" TargetType="ToggleButton" BasedOn="{StaticResource Button.Subtle}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== TextBox ==================== -->

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Layer.Alt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Radius.Control}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== Menus ==================== -->

  <Style TargetType="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource Brush.Stroke.Default}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource Radius.Control}" Margin="4,1" Padding="8,5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                         FontFamily="{DynamicResource Font.Icons}" FontSize="11"
                         VerticalAlignment="Center" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.Text.Primary}" />

              <ContentPresenter Grid.Column="1" ContentSource="Header"
                                VerticalAlignment="Center" RecognizesAccessKey="True" />

              <TextBlock Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"
                         Text="{TemplateBinding InputGestureText}"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"
                         FontSize="{DynamicResource Font.Size.Small}" />

              <TextBlock x:Name="Arrow" Grid.Column="3" Margin="10,0,0,0" Text="&#xE76C;"
                         FontFamily="{DynamicResource Font.Icons}" FontSize="10"
                         VerticalAlignment="Center" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.Text.Secondary}" />

              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Right" HorizontalOffset="6" VerticalOffset="-6"
                     PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.Layer.Raised}"
                        BorderBrush="{DynamicResource Brush.Stroke.Default}"
                        BorderThickness="1" CornerRadius="{DynamicResource Radius.Layer}"
                        Padding="0,4" MinWidth="180">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Direction="270" />
                  </Border.Effect>
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Subtle.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Brush.Layer.Raised}"
                  BorderBrush="{DynamicResource Brush.Stroke.Default}"
                  BorderThickness="1" CornerRadius="{DynamicResource Radius.Layer}"
                  Padding="0,4" MinWidth="190">
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Direction="270" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== ToolTip ==================== -->

  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Brush.Layer.Raised}"
                  BorderBrush="{DynamicResource Brush.Stroke.Default}"
                  BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}"
                  Padding="8,5">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== ComboBox ==================== -->

  <Style x:Key="ComboBox.ToggleButton" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{DynamicResource Brush.Layer.Alt}"
                  BorderBrush="{DynamicResource Brush.Stroke.Default}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Control}" SnapsToDevicePixels="True">
            <Grid>
              <ContentPresenter Margin="8,0,26,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <TextBlock Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="&#xE70D;" FontFamily="{DynamicResource Font.Icons}" FontSize="9"
                         Foreground="{DynamicResource Brush.Text.Secondary}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Strong}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" Margin="4,1"
                  CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Subtle.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selection}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_Toggle" Style="{StaticResource ComboBox.ToggleButton}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ContentPresenter ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                TextBlock.Foreground="{DynamicResource Brush.Text.Primary}" />
            </ToggleButton>

            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   PopupAnimation="Fade"
                   MinWidth="{TemplateBinding ActualWidth}">
              <Border Background="{DynamicResource Brush.Layer.Raised}"
                      BorderBrush="{DynamicResource Brush.Stroke.Default}" BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.Layer}" Padding="0,4" Margin="0,2,0,0"
                      MaxHeight="320">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Direction="270" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== ProgressBar ==================== -->

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Layer.Raised}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="2">
            <Grid>
              <Rectangle x:Name="PART_Track" />
              <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                         Fill="{TemplateBinding Foreground}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== Slider (video seek / volume) ==================== -->

  <!-- The decrease button doubles as the "filled" part of the track, which
       avoids having to bind a width against the value range. -->
  <Style x:Key="Slider.FillButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                  Background="{DynamicResource Brush.Accent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Slider.Fluent" TargetType="Slider">
    <Setter Property="Height" Value="18" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center" Background="Transparent">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Layer.Raised}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Slider.FillButton}"
                              Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="14">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid>
                        <Ellipse Fill="{DynamicResource Brush.Layer.Raised}"
                                 Stroke="{DynamicResource Brush.Stroke.Strong}" StrokeThickness="1" />
                        <Ellipse Margin="3" Fill="{DynamicResource Brush.Accent}" />
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                              Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
