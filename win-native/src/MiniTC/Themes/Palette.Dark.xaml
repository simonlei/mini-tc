<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Windows 11 Fluent dark tokens, flattened to opaque colours so they also
       look correct on Windows 10 where there is no Mica backdrop behind them. -->

  <Color x:Key="Color.App.Background">#FF202020</Color>
  <Color x:Key="Color.Layer.Background">#FF272727</Color>
  <Color x:Key="Color.Layer.Alt">#FF2D2D2D</Color>
  <Color x:Key="Color.Layer.Raised">#FF323232</Color>

  <Color x:Key="Color.Stroke.Default">#FF383838</Color>
  <Color x:Key="Color.Stroke.Strong">#FF484848</Color>

  <Color x:Key="Color.Text.Primary">#FFFFFFFF</Color>
  <Color x:Key="Color.Text.Secondary">#FFC8C8C8</Color>
  <Color x:Key="Color.Text.Tertiary">#FF8F8F8F</Color>
  <Color x:Key="Color.Text.Disabled">#FF6B6B6B</Color>

  <Color x:Key="Color.Subtle.Hover">#14FFFFFF</Color>
  <Color x:Key="Color.Subtle.Pressed">#0AFFFFFF</Color>

  <Color x:Key="Color.Selection">#33FFFFFF</Color>
  <Color x:Key="Color.Selection.Inactive">#1FFFFFFF</Color>

  <Color x:Key="Color.Danger">#FFFF99A4</Color>
  <Color x:Key="Color.Success">#FF6CCB5F</Color>
  <Color x:Key="Color.Warning">#FFFCE100</Color>

  <SolidColorBrush x:Key="Brush.App.Background" Color="{StaticResource Color.App.Background}" />
  <SolidColorBrush x:Key="Brush.Layer.Background" Color="{StaticResource Color.Layer.Background}" />
  <SolidColorBrush x:Key="Brush.Layer.Alt" Color="{StaticResource Color.Layer.Alt}" />
  <SolidColorBrush x:Key="Brush.Layer.Raised" Color="{StaticResource Color.Layer.Raised}" />

  <SolidColorBrush x:Key="Brush.Stroke.Default" Color="{StaticResource Color.Stroke.Default}" />
  <SolidColorBrush x:Key="Brush.Stroke.Strong" Color="{StaticResource Color.Stroke.Strong}" />

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />

  <SolidColorBrush x:Key="Brush.Subtle.Hover" Color="{StaticResource Color.Subtle.Hover}" />
  <SolidColorBrush x:Key="Brush.Subtle.Pressed" Color="{StaticResource Color.Subtle.Pressed}" />

  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
  <SolidColorBrush x:Key="Brush.Selection.Inactive" Color="{StaticResource Color.Selection.Inactive}" />

  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />

  <SolidColorBrush x:Key="Brush.Preview.Canvas" Color="#FF171717" />

</ResourceDictionary>
